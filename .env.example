# Environment configuration for Job Mentor
# Copy this file to .env and fill in values for your environment.

LOG_LEVEL=INFO
SEARCH_WINDOW_DAYS=14
DATABASE_PATH=data/job_mentor.db
TIMEZONE=Europe/Berlin
REPORT_HOUR=12
REPORT_MINUTE=0
JOB_PORTALS=Arbeitsagentur,StepStone,Meinestadt
ARBEITSAGENTUR_ENABLED=true
STEPSTONE_ENABLED=false
MEINESTADT_ENABLED=false
STEPSTONE_BASE_URL=https://www.stepstone.com
MEINESTADT_BASE_URL=https://jobs.meinestadt.de
MONITORING_ENABLED=false

# Keep secrets out of the repository.
# Do not add real credentials, API keys, passwords, or personal session data here.
