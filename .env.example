# Environment configuration for Job Mentor
# Copy this file to .env and fill in values for your environment.

LOG_LEVEL=INFO
SEARCH_WINDOW_DAYS=14
DATABASE_PATH=data/job_mentor.db
TIMEZONE=Europe/Berlin
REPORT_HOUR=12
REPORT_MINUTE=0
RECIPIENT_EMAIL=your-recipient@example.com
JOB_PORTALS=EURES,LinkedIn,Indeed,StepStone
MONITORING_ENABLED=false

# Example placeholders for future integrations.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your-smtp-username
SMTP_PASSWORD=change-me

# Keep secrets out of the repository.
# Do not add real credentials or API keys here.
