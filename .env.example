# Environment configuration for Job Mentor
# Copy this file to .env and fill in values for your environment.

LOG_LEVEL=INFO
SEARCH_WINDOW_DAYS=14
DATABASE_PATH=data/job_mentor.db
TIMEZONE=Europe/Berlin
REPORT_HOUR=12
REPORT_MINUTE=0
JOB_PORTALS=Arbeitsagentur,StepStone,Meinestadt,WerkNL,NationaleVacaturebank,JobDigger,ArbeitSwiss,JobsCH,JobUpCH
ARBEITSAGENTUR_ENABLED=true
STEPSTONE_ENABLED=false
MEINESTADT_ENABLED=false
WERK_NL_ENABLED=false
NATIONALEVACATUREBANK_ENABLED=false
JOBDIGGER_ENABLED=false
JOBDIGGER_API_KEY=
ARBEIT_SWISS_ENABLED=false
JOBS_CH_ENABLED=false
JOBUP_CH_ENABLED=false
STEPSTONE_BASE_URL=https://www.stepstone.com
MEINESTADT_BASE_URL=https://jobs.meinestadt.de
WERK_NL_BASE_URL=https://www.werk.nl
NATIONALEVACATUREBANK_BASE_URL=https://www.nationalevacaturebank.nl
JOBDIGGER_BASE_URL=https://api.jobdigger.com
ARBEIT_SWISS_BASE_URL=https://www.arbeit.swiss
JOBS_CH_BASE_URL=https://www.jobs.ch
JOBUP_CH_BASE_URL=https://www.jobup.ch
MONITORING_ENABLED=false

# Keep secrets out of the repository.
# Do not add real credentials, API keys, passwords, or personal session data here.
